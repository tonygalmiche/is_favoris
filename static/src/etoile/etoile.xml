<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Owl 3 : this. obligatoire dans le template ; Odoo 20 : icônes Material (oi, data-icon) -->
    <t t-name="is_favoris.Etoile">
        <t t-if="this.visible">
            <t t-set="liste" t-value="this.existants"/>
            <button t-if="!liste.length" type="button"
                    class="btn btn-link o_is_favoris_etoile px-1 py-0"
                    data-tooltip="Ajouter aux favoris" aria-label="Ajouter aux favoris"
                    t-on-click="() => this.ajouter()">
                <i class="oi" data-icon="star" role="img" aria-hidden="true"/>
            </button>
            <Dropdown t-else="" position="'bottom-start'" menuClass="'o_is_favoris_etoile_menu'">
                <button type="button" class="btn btn-link o_is_favoris_etoile o_is_favoris_etoile_jaune px-1 py-0"
                        data-tooltip="Déjà dans les favoris" aria-label="Déjà dans les favoris">
                    <i class="oi oi-filled" data-icon="star" role="img" aria-hidden="true"/>
                </button>
                <t t-set-slot="content">
                    <t t-set="rechercheAffichee" t-value="this.descriptionFiltre()"/>
                    <t t-foreach="this.favorisMenu" t-as="favori" t-key="favori.id">
                        <div class="dropdown-header o_is_favoris_etoile_entete">
                            <div class="fw-bold text-body">
                                <i t-if="favori.description_filtre and favori.description_filtre === rechercheAffichee"
                                   class="oi text-success me-1" data-icon="check" role="img"
                                   title="Recherche affichée" aria-label="Recherche affichée"/>
                                <t t-out="favori.name"/>
                            </div>
                            <div class="small text-muted" t-out="favori.description_filtre or 'Sans recherche mémorisée'"/>
                        </div>
                        <DropdownItem onSelected="() => this.mettreAJour(favori)">
                            <i class="oi me-2" data-icon="autorenew" role="img" aria-hidden="true"/>Mettre à jour avec la vue affichée
                        </DropdownItem>
                        <DropdownItem onSelected="() => this.retirer(favori)">
                            <i class="oi me-2" data-icon="delete" role="img" aria-hidden="true"/>Retirer des favoris
                        </DropdownItem>
                        <div class="dropdown-divider"/>
                    </t>
                    <DropdownItem onSelected="() => this.ajouter()">
                        <i class="oi me-2" data-icon="add" role="img" aria-hidden="true"/>Ajouter un nouveau favori
                    </DropdownItem>
                </t>
            </Dropdown>
        </t>
    </t>

    <!-- Étoile juste avant la roue dentée, dans les 3 affichages du panneau de contrôle -->
    <t t-inherit="web.ControlPanel" t-inherit-mode="extension">
        <!-- Liste des favoris : boutons Page / Liste à droite, comme les boutons de changement de vue -->
        <xpath expr="//t[@t-call-slot='control-panel-navigation-additional']" position="before">
            <nav t-if="this.env.searchModel?.resModel === 'is.favoris' and this.env.config.viewType === 'list'"
                 class="o_cp_switch_buttons d-print-none d-inline-flex btn-group">
                <button class="btn btn-secondary" data-tooltip="Page des favoris" aria-label="Page des favoris"
                        t-on-click="() => this.actionService.doAction('is_favoris.action_is_favoris_page', { clearBreadcrumbs: true })">
                    <i class="oi oi-fw" data-icon="grid_view" role="img" aria-hidden="true"/>
                </button>
                <button class="btn btn-secondary active" data-tooltip="Liste" aria-label="Liste">
                    <i class="oi oi-fw" data-icon="reorder" role="img" aria-hidden="true"/>
                </button>
            </nav>
        </xpath>
        <xpath expr="//t[@t-set-slot='breadcrumb-additional-actions']/t[@t-call-slot='control-panel-additional-actions']" position="before">
            <IsFavorisEtoile/>
        </xpath>
        <xpath expr="//t[@t-if='this.env.config.noBreadcrumbs']/section/t[@t-call-slot='control-panel-additional-actions']" position="before">
            <IsFavorisEtoile/>
        </xpath>
        <!-- Odoo 20 sur petit écran : actions supplémentaires dans la zone de navigation -->
        <xpath expr="//div[hasclass('o_control_panel_navigation')]/t[@t-if='this.uiService.isSmall']/t[@t-call-slot='control-panel-additional-actions']" position="before">
            <IsFavorisEtoile/>
        </xpath>
    </t>

</templates>
