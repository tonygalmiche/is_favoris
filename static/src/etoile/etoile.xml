<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="is_favoris.Etoile" owl="1">
        <t t-if="visible">
            <t t-set="liste" t-value="existants"/>
            <button t-if="!liste.length" type="button"
                    class="btn btn-link o_is_favoris_etoile px-1 py-0"
                    data-tooltip="Ajouter aux favoris"
                    t-on-click="ajouter">
                <i class="fa fa-star-o"/>
            </button>
            <Dropdown t-else="" position="'bottom-start'" showCaret="false"
                      class="'o_is_favoris_etoile_dropdown'"
                      menuClass="'o_is_favoris_etoile_menu'"
                      togglerClass="'btn btn-link o_is_favoris_etoile o_is_favoris_etoile_jaune px-1 py-0'"
                      tooltip="'Déjà dans les favoris'">
                <t t-set-slot="toggler">
                    <i class="fa fa-star"/>
                </t>
                <t t-set="rechercheAffichee" t-value="descriptionFiltre()"/>
                <t t-foreach="favorisMenu" t-as="favori" t-key="favori.id">
                    <div class="dropdown-header o_is_favoris_etoile_entete">
                        <div class="fw-bold text-body">
                            <i t-if="favori.description_filtre and favori.description_filtre === rechercheAffichee"
                               class="fa fa-check text-success me-1" title="Recherche affichée"/>
                            <t t-esc="favori.name"/>
                        </div>
                        <div class="small text-muted" t-esc="favori.description_filtre or 'Sans recherche mémorisée'"/>
                    </div>
                    <DropdownItem onSelected="() => this.mettreAJour(favori)">
                        <i class="fa fa-refresh me-2"/>Mettre à jour avec la vue affichée
                    </DropdownItem>
                    <DropdownItem onSelected="() => this.retirer(favori)">
                        <i class="fa fa-trash me-2"/>Retirer des favoris
                    </DropdownItem>
                    <div class="dropdown-divider"/>
                </t>
                <DropdownItem onSelected="() => this.ajouter()">
                    <i class="fa fa-plus me-2"/>Ajouter un nouveau favori
                </DropdownItem>
            </Dropdown>
        </t>
    </t>

    <!-- Étoile à côté du titre (dernier élément du fil d'Ariane), aussi dans les formulaires -->
    <t t-inherit="web.Breadcrumbs" t-inherit-mode="extension" owl="1">
        <xpath expr="//li[hasclass('active')]/t[@t-slot='control-panel-status-indicator']" position="before">
            <IsFavorisEtoile/>
        </xpath>
    </t>

    <t t-inherit="web.Breadcrumbs.Small" t-inherit-mode="extension" owl="1">
        <xpath expr="//li[hasclass('active')]" position="inside">
            <IsFavorisEtoile/>
        </xpath>
    </t>

    <!-- Liste des favoris : boutons Page / Liste à droite, comme les boutons de changement de vue -->
    <t t-inherit="web.ControlPanel.Regular" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('o_cp_bottom_right')]/t[@t-if='env.config.viewSwitcherEntries.length > 1']" position="before">
            <nav t-if="env.searchModel?.resModel === 'is.favoris' and env.config.viewType === 'list'"
                 class="btn-group o_cp_switch_buttons d-print-none">
                <button class="btn btn-light" data-tooltip="Page des favoris"
                        t-on-click="() => this.actionService.doAction('is_favoris.action_is_favoris_page', { clearBreadcrumbs: true })">
                    <i class="fa fa-th-large"/>
                </button>
                <button class="btn btn-light active" data-tooltip="Liste">
                    <i class="oi oi-view-list"/>
                </button>
            </nav>
        </xpath>
    </t>

</templates>
