<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_is_favoris_form" model="ir.ui.view">
        <field name="name">is.favoris.form</field>
        <field name="model">is.favoris</field>
        <field name="arch" type="xml">
            <form string="Favori" create="false">
                <sheet>
                    <field name="image" widget="image" class="oe_avatar" options="{'size': [90, 90]}"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nom du favori"/></h1>
                    </div>
                    <group>
                        <group string="Affichage">
                            <field name="color" widget="color_picker" attrs="{'invisible': [('image', '!=', False)]}"/>
                            <field name="icone" attrs="{'invisible': [('image', '!=', False)]}"/>
                            <field name="image_seule" attrs="{'invisible': [('image', '=', False)]}"/>
                        </group>
                        <group string="Origine">
                            <field name="chemin_menu"/>
                            <field name="view_type" invisible="1"/>
                            <field name="nom_type_vue"/>
                            <field name="res_id" readonly="1" attrs="{'invisible': [('view_type', '!=', 'form')]}"/>
                        </group>
                    </group>
                    <group string="Mémorisé">
                        <field name="description_filtre" readonly="1"/>
                        <field name="create_date" string="Créé le" readonly="1"/>
                        <field name="date_mise_a_jour" readonly="1"/>
                        <field name="domain" readonly="1" groups="base.group_no_one"/>
                        <field name="context" readonly="1" groups="base.group_no_one"/>
                        <field name="sort" readonly="1" groups="base.group_no_one"/>
                        <field name="action_data" readonly="1" groups="base.group_no_one" attrs="{'invisible': [('action_data', '=', False)]}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_is_favoris_page" model="ir.actions.client">
        <field name="name">Favoris</field>
        <field name="tag">is_favoris.page</field>
    </record>

    <record id="view_is_favoris_list" model="ir.ui.view">
        <field name="name">is.favoris.list</field>
        <field name="model">is.favoris</field>
        <field name="arch" type="xml">
            <tree string="Favoris" create="false">
                <field name="name"/>
                <field name="chemin_menu"/>
                <field name="nom_type_vue"/>
                <field name="ligne"/>
                <field name="colonne"/>
                <field name="user_id" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_is_favoris_search" model="ir.ui.view">
        <field name="name">is.favoris.search</field>
        <field name="model">is.favoris</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="menu_id"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_view_type" string="Type de vue" context="{'group_by': 'nom_type_vue'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_is_favoris_liste" model="ir.actions.act_window">
        <field name="name">Liste des favoris</field>
        <field name="res_model">is.favoris</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_is_favoris_root" name="Favoris" sequence="-1"
              web_icon="is_favoris,static/description/icon.png"
              groups="is_favoris.group_has_favorites"
              action="action_is_favoris_page"/>

</odoo>
